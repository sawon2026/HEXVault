{
  "name": "hexvault",
  "version": "1.0.0",
  "description": "Production AI Memory Platform + Smart PR Reviewer — hybrid search, multi-provider LLM, ranking, CI/CD",
  "type": "module",
  "bin": {
    "hexvault": "./dist/cli/index.js"
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsx src/cli/index.ts",
    "start": "node dist/cli/index.js",
    "action": "tsx src/action/index.ts",
    "dashboard": "tsx src/dashboard/server.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint src --ext .ts"
  },
  "keywords": [
    "github",
    "pr-review",
    "memory",
    "ai",
    "code-review",
    "hexvault",
    "project-memory",
    "github-action",
    "gitlab",
    "bitbucket",
    "rag",
    "vector-search"
  ],
  "author": "sawon2026",
  "license": "MIT",
  "dependencies": {
    "@actions/core": "^1.11.1",
    "@actions/github": "^6.0.0",
    "better-sqlite3": "^11.7.0",
    "chalk": "^6.0.0",
    "commander": "^12.1.0",
    "fast-glob": "^3.3.3",
    "openai": "^4.77.0",
    "yaml": "^2.6.1",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.12",
    "@types/node": "^22.10.5",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  },
  "engines": {
    "node": ">=18"
  }
}
