{
  "name": "hexvault",
  "version": "3.0.0",
  "description": "HEXVault — AI Memory Platform: project memory, smart PR review, multi-provider LLMs, SDKs, dashboard, knowledge graph",
  "type": "module",
  "bin": {
    "hexvault": "./dist/cli/index.js"
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsx src/cli/index.ts",
    "start": "node dist/cli/index.js",
    "action": "tsx src/action/index.ts",
    "dashboard": "tsx src/dashboard/server.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint src tests packages/sdk/src --ext .ts",
    "lint:fix": "eslint src tests packages/sdk/src --ext .ts --fix",
    "format": "prettier --write \"src/**/*.ts\" \"tests/**/*.ts\" \"packages/sdk/src/**/*.ts\"",
    "format:check": "prettier --check \"src/**/*.ts\" \"tests/**/*.ts\" \"packages/sdk/src/**/*.ts\"",
    "api": "tsx src/api/server.ts",
    "web": "npm run dev --prefix apps/web",
    "web:install": "npm install --prefix apps/web",
    "web:build": "npm run build --prefix apps/web",
    "sdk:build": "npm run build --prefix packages/sdk",
    "typecheck": "tsc --noEmit",
    "audit": "npm audit --omit=dev --audit-level=high"
  },
  "keywords": [
    "github",
    "pr-review",
    "memory",
    "ai",
    "code-review",
    "hexvault",
    "project-memory",
    "github-action",
    "gitlab",
    "bitbucket",
    "rag",
    "knowledge-graph",
    "semantic-search"
  ],
  "author": "sawon2026",
  "license": "MIT",
  "dependencies": {
    "@actions/core": "^1.11.1",
    "@actions/github": "^6.0.0",
    "chalk": "^5.4.1",
    "commander": "^12.1.0",
    "fast-glob": "^3.3.3",
    "yaml": "^2.6.1",
    "zod": "^3.24.1"
  },
  "optionalDependencies": {
    "better-sqlite3": "^11.10.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@types/node": "^22.10.5",
    "@typescript-eslint/eslint-plugin": "^8.18.2",
    "@typescript-eslint/parser": "^8.18.2",
    "@vitest/coverage-v8": "^2.1.8",
    "eslint": "^9.17.0",
    "globals": "^15.14.0",
    "prettier": "^3.4.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  },
  "engines": {
    "node": ">=18"
  }
}
