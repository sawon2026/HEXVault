{
  "name": "hexvault",
  "version": "2.2.0",
  "description": "HEXVault — Go/Python/TS SDKs, GraphQL, multi-repo, TUI, dashboard",
  "type": "module",
  "bin": { "hexvault": "./dist/cli/index.js" },
  "scripts": {
    "build": "tsc",
    "dev": "tsx src/cli/index.ts",
    "api": "tsx src/api/server.ts",
    "tui": "tsx src/cli/index.ts tui",
    "web": "npm run dev --prefix apps/web",
    "sdk:build": "npm run build --prefix packages/sdk",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage"
  },
  "author": "sawon2026",
  "license": "MIT",
  "dependencies": {
    "@actions/core": "^1.11.1",
    "@actions/github": "^6.0.0",
    "better-sqlite3": "^11.7.0",
    "chalk": "^5.4.1",
    "commander": "^12.1.0",
    "fast-glob": "^3.3.3",
    "openai": "^4.77.0",
    "yaml": "^2.6.1",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.12",
    "@types/node": "^22.10.5",
    "@vitest/coverage-v8": "^2.1.8",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  },
  "engines": { "node": ">=18" }
}
